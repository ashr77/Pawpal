{
  "name": "pawpal-server",
  "version": "1.0.0",
  "description": "PawPal REST API Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate -m ../database/migrations up",
    "db:migrate:down": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate -m ../database/migrations down",
    "db:migrate:create": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate -m ../database/migrations create",
    "db:seed": "node -r dotenv/config src/config/seed.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
